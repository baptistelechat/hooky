{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "curl -s -m 5 -X POST http://127.0.0.1:4242/event -H \"Content-Type: application/json\" -d @- || start \"\" \"%LOCALAPPDATA%\\Hooky\\Hooky.exe\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "http", "url": "http://127.0.0.1:4242/event", "timeout": 5 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "http", "url": "http://127.0.0.1:4242/event", "timeout": 5 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "http", "url": "http://127.0.0.1:4242/event", "timeout": 5 }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "http", "url": "http://127.0.0.1:4242/event", "timeout": 5 }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          { "type": "http", "url": "http://127.0.0.1:4242/event", "timeout": 5 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "http", "url": "http://127.0.0.1:4242/event", "timeout": 5 }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          { "type": "http", "url": "http://127.0.0.1:4242/event", "timeout": 5 }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          { "type": "http", "url": "http://127.0.0.1:4242/event", "timeout": 5 }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          { "type": "http", "url": "http://127.0.0.1:4242/event", "timeout": 5 }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          { "type": "http", "url": "http://127.0.0.1:4242/event", "timeout": 5 }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          { "type": "http", "url": "http://127.0.0.1:4242/event", "timeout": 5 }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          { "type": "http", "url": "http://127.0.0.1:4242/event", "timeout": 5 }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          { "type": "http", "url": "http://127.0.0.1:4242/event", "timeout": 5 }
        ]
      }
    ],
    "Elicitation": [
      {
        "hooks": [
          { "type": "http", "url": "http://127.0.0.1:4242/event", "timeout": 5 }
        ]
      }
    ]
  }
}
